{
  "id": "perplexity",
  "description": "Perplexity provider for Agent API models and web search.",
  "categories": [
    "web",
    "models"
  ],
  "activation": {
    "onStartup": false
  },
  "providers": [
    "perplexity-agent"
  ],
  "providerEndpoints": [
    {
      "endpointClass": "perplexity-native",
      "hosts": [
        "api.perplexity.ai"
      ]
    }
  ],
  "modelCatalog": {
    "modelsDev": {
      "perplexity-agent": "perplexity-agent"
    },
    "providers": {
      "perplexity-agent": {
        "baseUrl": "https://api.perplexity.ai/v1",
        "api": "openai-responses",
        "defaultModel": "openai/gpt-5.5",
        "models": [
          {
            "id": "openai/gpt-5.5",
            "name": "GPT-5.5",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 1050000,
            "maxTokens": 128000,
            "cost": {
              "input": 5,
              "output": 30,
              "cacheRead": 0.5,
              "cacheWrite": 0
            }
          },
          {
            "id": "perplexity/sonar",
            "name": "Sonar",
            "reasoning": false,
            "input": [
              "text"
            ],
            "contextWindow": 128000,
            "maxTokens": 8192,
            "cost": {
              "input": 0.25,
              "output": 2.5,
              "cacheRead": 0.0625,
              "cacheWrite": 0
            }
          }
        ]
      }
    }
  },
  "setup": {
    "providers": [
      {
        "id": "perplexity",
        "envVars": [
          "PERPLEXITY_API_KEY",
          "OPENROUTER_API_KEY"
        ]
      },
      {
        "id": "perplexity-agent",
        "envVars": [
          "PERPLEXITY_API_KEY"
        ]
      }
    ]
  },
  "providerAuthChoices": [
    {
      "provider": "perplexity-agent",
      "method": "api-key",
      "choiceId": "perplexity-agent-api-key",
      "appGuidedSecret": true,
      "choiceLabel": "Perplexity API key",
      "groupId": "perplexity",
      "groupLabel": "Perplexity",
      "groupHint": "Agent API models",
      "optionKey": "perplexityApiKey",
      "cliFlag": "--perplexity-api-key",
      "cliOption": "--perplexity-api-key <key>",
      "cliDescription": "Perplexity API key"
    }
  ],
  "uiHints": {
    "webSearch.apiKey": {
      "label": "Perplexity API Key",
      "help": "Perplexity or OpenRouter API key for web search.",
      "sensitive": true,
      "placeholder": "pplx-..."
    },
    "webSearch.baseUrl": {
      "label": "Perplexity Base URL",
      "help": "Optional Perplexity/OpenRouter chat-completions base URL override."
    },
    "webSearch.model": {
      "label": "Perplexity Model",
      "help": "Optional Sonar/OpenRouter model override."
    }
  },
  "contracts": {
    "webSearchProviders": [
      "perplexity"
    ]
  },
  "configGroups": [
    {
      "id": "web-search",
      "title": "Web search",
      "order": 10,
      "properties": [
        "webSearch"
      ]
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "webSearch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "apiKey": {
            "type": [
              "string",
              "object"
            ]
          },
          "baseUrl": {
            "type": "string"
          },
          "model": {
            "type": "string"
          }
        }
      }
    }
  }
}
